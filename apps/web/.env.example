# Nothing to set for the data path: the last-run records live in the KV
# namespace bound as KV in wrangler.jsonc (rendered by `pnpm run wire:fixture`
# for local work, and from the cloudflare-kv root's wiring document on
# deploy). Vercel KV's KV_URL / KV_REST_API_* are gone.

# Optional: Cloudflare Web Analytics in place of @vercel/analytics. Build-time
# public; the beacon script is rendered only when this is set (Cloudflare
# dashboard → Web Analytics → add a site → the JS snippet token).
NEXT_PUBLIC_CF_BEACON_TOKEN=
