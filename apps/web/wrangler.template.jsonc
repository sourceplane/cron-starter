// The source of wrangler.jsonc, which tooling/wire renders from it: from
// wiring.fixture.json for local work (`pnpm run wire:fixture`, committed as
// that render), and on every Orun lane from the wiring document the
// `cloudflare-kv` Terraform root lease-publishes (WIRING_CLOUDFLARE_KV_<ENV>)
// — dev, which no root applies to, from the fixture (component.yaml's
// buildCommand). Edit this file, never wrangler.jsonc. The workers-assets
// composition deploys one environment per job with no wrangler `--env`, so
// `__ENV__` names the environment this is rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cron-starter-web",
  // The custom entry: the fetch handler @opennextjs/cloudflare generates plus
  // the `scheduled` handler Cron Triggers call (see worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // ONE Cron Trigger, every minute. The seven schedules vercel.json declared
  // are dispatched from it: lib/crons.ts holds them, and the scheduled handler
  // runs the route (/api/cron/<interval>) of every schedule whose expression
  // matches the minute the trigger was scheduled for. One trigger per Worker —
  // two for stage and prod — fits Workers Free's five per account.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // The last-run store — Workers KV in place of Vercel KV.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "@@wiring(cloudflare-kv/__ENV__:app_kv_id)@@"
    }
  ]
}
